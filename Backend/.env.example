# NASA API Configuration
# Get your free API key from: https://api.nasa.gov/
NASA_API_KEY=your_nasa_api_key_here

# MongoDB Configuration
# Local development:
MONGO_URI=mongodb://localhost:27017
# Production (MongoDB Atlas example):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=neovision
COLLECTION_NAME=asteroids

# Server Configuration
PORT=5000
# Set to 'production' when deploying
NODE_ENV=development

# AI Service Configuration (Choose one)
# Google Gemini - Get key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (Optional alternative) - Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# CORS Configuration - IMPORTANT FOR PRODUCTION!
# Development (local):
# FRONTEND_URL=http://localhost:5173
# Production - Your deployed frontend URL:
FRONTEND_URL=https://neo-vision-hr.vercel.app

# Fetch Configuration
FETCH_INTERVAL_HOURS=1
ASTEROID_LIMIT=5
